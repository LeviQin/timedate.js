{
  "name": "timedate.js",
  "version": "3.0.0",
  "description": "零依赖的现代日期时间工具库：格式化、计算、日历、相对时间、i18n、时区",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": "https://github.com/muqin6610/timeDate",
  "keywords": [
    "time",
    "date",
    "日期",
    "时间",
    "format",
    "格式化",
    "年月日",
    "时分秒",
    "闰年",
    "相对时间",
    "i18n",
    "timezone"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --target es2020",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
