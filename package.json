{
  "name": "timedate.js",
  "version": "3.2.0",
  "description": "零依赖的现代日期时间工具库：格式化、计算、日历、相对时间、i18n、时区",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeviQin/timedate.js.git"
  },
  "bugs": {
    "url": "https://github.com/LeviQin/timedate.js/issues"
  },
  "homepage": "https://github.com/LeviQin/timedate.js#readme",
  "keywords": [
    "time",
    "date",
    "日期",
    "时间",
    "format",
    "格式化",
    "年月日",
    "时分秒",
    "闰年",
    "相对时间",
    "i18n",
    "timezone"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --target es2020",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:exports": "node scripts/verify-exports.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run verify:exports && npm pack --dry-run",
    "prepublishOnly": "npm run verify"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
